{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "https://playtreehouse.com"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://google.com https://*.googleusercontent.com" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
